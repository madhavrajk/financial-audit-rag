# Setup: copy this file to .env, paste an API key after LLM_API_KEY= below, then (re)start the app.
#
# The default is Google Gemini's free tier. To get a key, go to
# https://aistudio.google.com/apikey, sign in with a Google account, and click
# "Create API key". No credit card. Notes on the free tier:
#   - It allows only a few requests per minute, and a question takes about three. If you ask
#     several in a row, the app waits for the limit to reset.
#   - Google may use free-tier requests to improve its products.
#   - Google retires models often. If requests fail with "no longer available", set LLM_MODEL
#     to a current Flash-Lite model from https://ai.google.dev/gemini-api/docs/models
#     (Flash-Lite answered fastest and most reliably on the free tier in testing).

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# --- Other providers ---
# Any OpenAI-compatible provider with tool calling works. To switch, comment out the three
# Gemini lines above and uncomment one block below. Model IDs differ per provider.

# OpenRouter: open-weight models (the README benchmarks use gpt-oss-120b, about $0.001 per
# question). Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# OpenAI. Key: https://platform.openai.com/api-keys
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-5-mini

# Local with Ollama (no key, no cost; needs a model that handles tool calls well):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-oss:120b
# MODEL_PRICES={"gpt-oss:120b": [0, 0, 0]}

# --- Embeddings (optional; without them search is BM25-only) ---
# The prebuilt index in data/index/ uses Qwen3-Embedding-8B at 1024 dims, so any provider
# serving that model works without a rebuild. Base URL and key default to the LLM's.
# EMBED_BASE_URL=https://api.deepinfra.com/v1/openai
# EMBED_API_KEY=
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B
#   Ollama: EMBED_BASE_URL=http://localhost:11434/v1  EMBED_MODEL=qwen3-embedding:8b
#   Any other embedding model: set EMBED_MODEL, then rebuild with `uv run python -m app.ingest`.
# EMBED_DIMS=1024

# --- Adding companies by ticker (optional) ---
# `uv run python -m app.ingest add FILE` needs nothing extra. To download filings by ticker
# instead (`add NVDA`), SEC requires every automated request to carry a contact:
# SEC_USER_AGENT="Your Name you@example.com"

# --- Optional models ---
# ESCALATION_MODEL=      # used only if the grounding repair fails; empty disables
# REWRITE_MODEL=         # cheap model for follow-up rewriting; defaults to LLM_MODEL
# JUDGE_MODEL=           # evals only; defaults to LLM_MODEL (a different family is better)

# Cost accounting, USD per 1M tokens: {"model": [input, cached_input, output]}
# MODEL_PRICES={"my-model": [0.15, 0.015, 0.60]}

# Behaviour
# MAX_STEPS=8
# REASONING_EFFORT=low
# ANSWER_CACHE=memory          # memory | none
# RATE_LIMIT_PER_MINUTE=30

# Server (Docker sets HOST=0.0.0.0)
# HOST=127.0.0.1
# PORT=8000
